const modal = document.getElementById('artworkModal');
const modalBody = document.getElementById('modalBody');
const closeModal = document.getElementById('closeModal');

function openModal(art) {
    modalBody.innerHTML = `
        <h2 style="margin-bottom: 0.5rem; font-size: 1.8rem;">${art.title}</h2>
        <p style="font-family: var(--font-mono); color: var(--accent); margin-bottom: 1.5rem;">${art.tags}</p>
        <div style="width: 100%; height: 300px; background: #000; display: flex; align-items: center; justify-content: center; border-radius: 6px; margin-bottom: 1.5rem;">
            <span style="font-family: var(--font-mono); color: var(--text-muted);">Preview Media Area (${art.id})</span>
        </div>
        <p style="color: var(--text-muted); font-size: 1rem;">${art.description}</p>
    `;
    modal.classList.remove('hidden');
}

closeModal.addEventListener('click', () => modal.classList.add('hidden'));
modal.addEventListener('click', (e) => {
    if (e.target === modal) modal.classList.add('hidden');
});

// **********************************************************
// **********************************************************
// 4. NEW HERO INTERACTIVE LCD CANVAS Visual System
// **********************************************************
// **********************************************************

function initHeroCanvas() {
    const canvas = document.getElementById('heroCanvas');
    const ctx = canvas.getContext('2d', { alpha: true });
    
    let width, height;
    let dpi = window.devicePixelRatio || 1;

    // --- LCD Simulation Parameters ---
    const pixelSize = 6;              // Size of an entire RGB cluster
    const interactionRadius = 180;    // How far the mouse effects pixels
    const mouseForce = 1.0;            // Brightness boost (1.0 = full light)
    const blurAmount = 14;            // Max blur of the 'hot zone'
    
    // Interaction State
    const mouse = { x: -200, y: -200 };
    let gridCols, gridRows;
    let gridData = [];
    
    // Re-calculates grid structure on resize
    function setupGrid() {
        width = canvas.width = window.innerWidth * dpi;
        height = canvas.height = window.innerHeight * dpi;
        // Scale back the context for DPI matching
        ctx.scale(dpi, dpi);
        
        const cssWidth = window.innerWidth;
        const cssHeight = window.innerHeight;

        gridCols = Math.ceil(cssWidth / pixelSize);
        gridRows = Math.ceil(cssHeight / pixelSize);
        gridData = [];

        for (let r = 0; r < gridRows; r++) {
            for (let c = 0; c < gridCols; c++) {
                gridData.push({
                    x: c * pixelSize,
                    y: r * pixelSize,
                    // Brightness (0.0 to 1.0)
                    intensity: 0,
                    // Suggested Glitch state
                    targetIntensity: 0
                });
            }
        }
    }

    window.addEventListener('resize', setupGrid);
    window.addEventListener('mousemove', (e) => {
        // Correct mouse coordinate for fixed-relative positioning of canvas
        mouse.x = e.clientX;
        mouse.y = e.clientY;
    });

    setupGrid(); // Initial build

    // --- Animate Loop ---
    function animate() {
        ctx.clearRect(0, 0, width, height);

        // Define base off-screen canvas grid for performance (drawing macroscopic pattern only once)
        const staticGridCanvas = document.createElement('canvas');
        staticGridCanvas.width = width; staticGridCanvas.height = height;
        const staticCtx = staticGridCanvas.getContext('2d');

        // Render the "dark/inactive" dense RGB pattern (RGB stripes)
        for (let r = 0; r < gridRows; r++) {
            for (let c = 0; c < gridCols; c++) {
                const px = c * pixelSize; const py = r * pixelSize;
                
                // Draw Microscopic RGB stripes [R,G,B][R,G,B]
                // 1. Red (Left third)
                staticCtx.fillStyle = 'rgba(100, 20, 20, 0.4)'; // Dim Red
                staticCtx.fillRect(px, py, pixelSize/3, pixelSize);
                // 2. Green (Center third)
                staticCtx.fillStyle = 'rgba(20, 100, 20, 0.4)'; // Dim Green
                staticCtx.fillRect(px + (pixelSize/3), py, pixelSize/3, pixelSize);
                // 3. Blue (Right third)
                staticCtx.fillStyle = 'rgba(20, 20, 100, 0.4)'; // Dim Blue
                staticCtx.fillRect(px + (pixelSize*2/3), py, pixelSize/3, pixelSize);
                
                // Draw thin separation line
                staticCtx.strokeStyle = 'rgba(0,0,0,0.3)'; staticCtx.lineWidth = 0.5;
                staticCtx.strokeRect(px, py, pixelSize, pixelSize);
            }
        }

        // Draw the base static grid
        ctx.drawImage(staticGridCanvas, 0, 0);

        // --- Now calculate and render the brightened 'hot zone' and blur ---
        // (This part must run every frame)

        gridData.forEach(cell => {
            const dx = cell.x - mouse.x;
            const dy = cell.y - mouse.y;
            const dist = Math.sqrt(dx * dx + dy * dy);

            // Calculate target brightness based on mouse distance
            if (dist < interactionRadius) {
                // Closer pixels light up fully (mouseForce), fading smoothly out to 0 at radius edge
                cell.targetIntensity = mouseForce * (1 - dist / interactionRadius);
            } else {
                cell.targetIntensity = 0;
            }

            // Smoothly ease the intensity (adds ghosting persistence)
            cell.intensity += (cell.targetIntensity - cell.intensity) * 0.15; // Ease factor
        });

        // Loop again and draw only the affected bright cells with blurring
        // To achieve blurring, we apply the blur *then* draw the bright overlay
        
        ctx.save(); // Save base state
        
        gridData.forEach(cell => {
            if(cell.intensity > 0.05) { // Only process brightly lit cells
                const px = cell.x; const py = cell.y;
                const brightness = cell.intensity;
                
                // Calculate dynamic blur amount based on intensity (brightest = least blurry, edges = most blurry)
                const dynamicBlur = blurAmount * (1 - brightness);
                ctx.filter = `blur(${dynamicBlur}px) contrast(1.2)`;

                // Draw bright version of the cell (Cyan 'glow' over RGB)
                // Use cell.intensity to modulate opacity of the accent glow
                ctx.fillStyle = `rgba(0, 240, 255, ${brightness * 0.8})`; // (Cyan Accent, transparent)
                ctx.fillRect(px, py, pixelSize, pixelSize);
            }
        });
        
        ctx.restore(); // Restore base state (turn off blurring for navigation etc.)
        
        requestAnimationFrame(animate);
    }
    
    animate();
}

// Initialize everything on page load
window.addEventListener('DOMContentLoaded', () => {
    renderGallery();
    initHeroCanvas();
});